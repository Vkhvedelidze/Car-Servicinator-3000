<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.programminggroupproject.controller.LoginController"
            styleClass="app-shell,login-screen" stylesheets="@workspace.css"
            prefWidth="800" prefHeight="600">
    <top>
        <HBox styleClass="app-toolbar" alignment="CENTER_LEFT">
            <Label text="Car Servicinator 3000" styleClass="app-name"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" focusTraversable="false">
            <content>
                <StackPane alignment="CENTER">
                    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                    <VBox spacing="20" maxWidth="380" maxHeight="-Infinity">
                        <VBox spacing="6">
                            <Label text="Sign in" styleClass="page-title"/>
                            <Label text="Access your vehicle services and requests." styleClass="body-muted" wrapText="true"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Email address" labelFor="${usernameField}" styleClass="field-label"/>
                            <TextField fx:id="usernameField" promptText="Enter your email address" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Password" labelFor="${passwordField}" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField" promptText="Enter your password"
                                           onAction="#handleLogin" maxWidth="Infinity"/>
                        </VBox>
                        <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="Infinity"
                               styleClass="status-error" managed="${!errorLabel.text.empty}" visible="${!errorLabel.text.empty}"/>
                        <Button text="Sign in" onAction="#handleLogin" defaultButton="true" maxWidth="Infinity"
                                styleClass="button,button-primary"/>
                        <Button text="Create an account" onAction="#handleRegister" maxWidth="Infinity"
                                styleClass="button,button-secondary"/>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
