<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.programminggroupproject.controller.ClientController"
            fx:id="requestRoot" styleClass="app-shell,request-screen"
            stylesheets="@workspace.css" prefWidth="900" prefHeight="720">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="app-toolbar">
            <Label text="Car Servicinator 3000" styleClass="app-name" minWidth="0"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="Dashboard" onAction="#handleBack" styleClass="button,button-quiet"/>
            <Button fx:id="paymentsButton" text="Payments" onAction="#handleViewPayments" styleClass="button,button-quiet"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="formScroll" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="scroll-pane,form-scroll" focusTraversable="false">
            <content>
                <VBox fx:id="formContent" spacing="28" maxWidth="900" styleClass="form-content">
                    <padding><Insets top="28" right="28" bottom="32" left="28"/></padding>
                    <VBox spacing="6">
                        <Label text="Request a service" styleClass="page-title"/>
                        <Label text="Choose your services, review the estimate, and set permission for any additional work."
                               styleClass="body-muted" wrapText="true" maxWidth="650"/>
                    </VBox>
                    <VBox spacing="16" styleClass="form-section">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="01" styleClass="section-number"/>
                            <Label text="Vehicle &amp; workshop" styleClass="section-title"/>
                        </HBox>
                        <HBox spacing="16">
                            <VBox spacing="6" prefWidth="300" minWidth="0" HBox.hgrow="ALWAYS">
                                <Label text="Vehicle" labelFor="${vehicleComboBox}" styleClass="field-label"/>
                                <ComboBox fx:id="vehicleComboBox" promptText="Choose a vehicle" minWidth="0" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="300" minWidth="0" HBox.hgrow="ALWAYS">
                                <Label text="Workshop" labelFor="${shopComboBox}" styleClass="field-label"/>
                                <ComboBox fx:id="shopComboBox" promptText="Choose a workshop" minWidth="0" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="12" styleClass="form-section">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="02" styleClass="section-number"/>
                            <Label text="Services" styleClass="section-title"/>
                        </HBox>
                        <Label text="Select the work you need. All prices are estimates in EUR."
                               styleClass="body-muted" wrapText="true"/>
                        <Label fx:id="catalogMessage" text="Loading services and prices…" wrapText="true"
                               maxWidth="Infinity" styleClass="status-info"/>
                        <Button fx:id="retryButton" text="Try loading again" onAction="#handleRetry"
                                visible="false" managed="false" styleClass="button,button-secondary"/>
                        <VBox fx:id="serviceList" spacing="0" styleClass="service-list"/>
                    </VBox>
                    <VBox spacing="14" styleClass="form-section">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="03" styleClass="section-number"/>
                            <Label text="Additional work" styleClass="section-title"/>
                        </HBox>
                        <Label text="Tell the mechanic what to do if your vehicle needs more work."
                               styleClass="body-muted" wrapText="true"/>
                        <RadioButton fx:id="permissionStrictRadio" text="Only perform the services I selected"
                                     wrapText="true" maxWidth="Infinity"/>
                        <VBox spacing="8">
                            <RadioButton fx:id="permissionExtraRadio" text="Allow additional work within a budget"
                                         wrapText="true" maxWidth="Infinity"/>
                            <VBox spacing="6" visible="${permissionExtraRadio.selected}" managed="${permissionExtraRadio.selected}">
                                <padding><Insets left="28"/></padding>
                                <Label text="Additional budget (€)" labelFor="${permissionBudgetField}" styleClass="field-label"/>
                                <TextField fx:id="permissionBudgetField" promptText="For example, 100.00"
                                           maxWidth="220" disable="true"/>
                                <Label text="This is extra to the service estimate." styleClass="caption" wrapText="true"/>
                            </VBox>
                        </VBox>
                        <RadioButton fx:id="permissionAskRadio" text="Contact me before doing any additional work"
                                     wrapText="true" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="12" styleClass="form-section">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="04" styleClass="section-number"/>
                            <Label text="Notes" labelFor="${notesArea}" styleClass="section-title"/>
                            <Label text="Optional" styleClass="caption"/>
                        </HBox>
                        <TextArea fx:id="notesArea" promptText="Describe any symptoms or details the mechanic should know."
                                  wrapText="true" prefRowCount="3" minHeight="100" maxHeight="160"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10" styleClass="estimate-bar">
            <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false" styleClass="status-info"/>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="3" HBox.hgrow="ALWAYS" minWidth="0">
                    <Label text="Estimated service total" styleClass="field-label"/>
                    <Label fx:id="totalPriceLabel" text="Unavailable" styleClass="estimate-value"/>
                    <Label fx:id="selectionCountLabel" text="No services selected" styleClass="caption"/>
                </VBox>
                <Button fx:id="submitButton" text="Submit request" onAction="#handleSubmit"
                        styleClass="button,button-primary" disable="true" minWidth="150"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
