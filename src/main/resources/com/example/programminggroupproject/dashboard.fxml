<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.programminggroupproject.controller.DashboardController"
            styleClass="app-shell,dashboard-screen" stylesheets="@workspace.css"
            prefWidth="800" prefHeight="600">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="app-toolbar">
            <Label text="Car Servicinator 3000" styleClass="app-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Sign out" onAction="#handleLogout" styleClass="button,button-quiet"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" focusTraversable="false">
            <content>
                <VBox spacing="32" maxWidth="800">
                    <padding><Insets top="40" right="32" bottom="40" left="32"/></padding>
                    <VBox spacing="8">
                        <Label text="Dashboard" styleClass="page-title"/>
                        <Label fx:id="welcomeLabel" text="Welcome" styleClass="body-muted" wrapText="true"/>
                    </VBox>
                    <VBox spacing="14" maxWidth="480">
                        <Label text="Your workspace" styleClass="section-title"/>
                        <Button fx:id="clientButton" text="Request a service" visible="false"
                                onAction="#handleClientAction" maxWidth="Infinity" alignment="CENTER_LEFT"
                                styleClass="button,button-primary,workspace-action"/>
                        <Button fx:id="clientRequestsButton" text="My requests" visible="false"
                                onAction="#handleClientRequestsAction" maxWidth="Infinity" alignment="CENTER_LEFT"
                                styleClass="button,button-secondary,workspace-action"/>
                        <Button fx:id="mechanicButton" text="View assigned jobs" visible="false"
                                onAction="#handleMechanicAction" maxWidth="Infinity" alignment="CENTER_LEFT"
                                styleClass="button,button-primary,workspace-action"/>
                        <Button fx:id="adminButton" text="Manage system" visible="false"
                                onAction="#handleAdminAction" maxWidth="Infinity" alignment="CENTER_LEFT"
                                styleClass="button,button-primary,workspace-action"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
